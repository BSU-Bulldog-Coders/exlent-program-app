# Postgres (Neon/Supabase). Use the pooled URL here...
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# ...and optionally a direct (non-pooled) URL used only by `prisma migrate`.
# DIRECT_URL=""

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs the rotating attendance QR tokens (falls back to BETTER_AUTH_SECRET)
ATTENDANCE_TOKEN_SECRET=""

# Resend. onboarding@resend.dev only delivers to your Resend account's own email
# until you verify a domain.
RESEND_API_KEY=""
RESEND_FROM="ExLENT Program <onboarding@resend.dev>"

# Authenticates Vercel's daily password-reset email retry request.
CRON_SECRET=""

# First admin, created by `bun run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Program Admin"
