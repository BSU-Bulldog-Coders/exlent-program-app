generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

enum JoinedVia {
  INVITE
  SELF
  SEED
}

enum ClassStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ClassReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AttendanceWarningStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum EmailOutboxKind {
  PASSWORD_RESET
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  ABANDONED
}

enum AnnouncementDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELED
}

enum ResourceKind {
  FILE
  YOUTUBE
}

enum ResourceUploadStatus {
  PENDING
  READY
}

// --- Better Auth core tables ---

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  // User-managed profile photo: the public URL of an upload to the avatars
  // bucket, set via PATCH /api/profile/image (multipart `image` field); never settable from client input through
  // the auth API. When null, the frontend renders a DiceBear adventurer
  // avatar (see lib/avatar.ts).
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletionScheduledAt DateTime?
  deletionDueAt       DateTime?

  // Never settable from client input (see lib/auth.ts).
  role      Role      @default(STUDENT)
  joinedVia JoinedVia @default(SELF)

  sessions     Session[]
  accounts     Account[]
  attendances  Attendance[]
  invitesSent  Invite[]     @relation("InvitedBy")
  classes      Class[]
  passwordResetRequests PasswordResetRequest[]
  announcementsAuthored Announcement[] @relation("AnnouncementAuthor")
  resourcesCreated      Resource[]    @relation("ResourceCreator")
  // The saved default used by this admin's announcement composer. It is ignored
  // for students, who never receive the admin management controls.
  announcementEmailDefault Boolean @default(false)
  // Leaderboard points. Only changed through adjustScore (lib/leaderboard.ts),
  // which clamps to 0..32767.
  totalScore Int @default(0) @map("total_score") @db.SmallInt
  scoreAdjustments ScoreAdjustment[]
  attendanceWarnings AttendanceWarning[]
  classReminders     ClassReminder[]
  exercisesCreated Exercise[] @relation("ExerciseCreator")
  exerciseProgress ExerciseProgress[]
  exerciseRuns ExerciseRun[]
  testcaseReports TestcaseReport[]

  @@index([deletionDueAt])
  @@index([totalScore(sort: Desc)])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// A durable record of each reset link that this application issues. Better Auth
// owns consuming the matching Verification record atomically with the password
// update; this table lets issuance and delivery be deduplicated safely.
model PasswordResetRequest {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationIdentifier String   @unique
  expiresAt              DateTime
  createdAt              DateTime @default(now())
  outbox                 EmailOutbox?

  @@index([userId, expiresAt])
}

// Transactional email outbox. A worker claims each event before sending it and
// always gives Resend the same idempotency key when delivery is retried.
model EmailOutbox {
  id                     String            @id @default(cuid())
  kind                   EmailOutboxKind
  to                     String
  payload                Json
  idempotencyKey         String            @unique
  status                 EmailOutboxStatus @default(PENDING)
  attempts               Int               @default(0)
  nextAttemptAt          DateTime          @default(now())
  lockedUntil            DateTime?
  leaseId                String?
  lastError              String?
  sentAt                 DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  passwordResetRequestId String            @unique
  passwordResetRequest   PasswordResetRequest @relation(fields: [passwordResetRequestId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

// --- Program domain ---

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(STUDENT)
  // sha256 of the raw token; the raw token only ever lives in the email link.
  tokenHash   String    @unique
  expiresAt   DateTime
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Class {
  id          String      @id @default(cuid())
  name        String
  description String?
  startsAt    DateTime
  // IANA timezone of the admin who created the class.
  timezone    String
  status      ClassStatus @default(DRAFT)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  openedAt    DateTime?
  closedAt    DateTime?
  // Set once the missed-classes check has run for this close (see
  // lib/attendance-warnings.ts). Reopening a class clears it so the next close
  // re-checks; the daily cron re-runs any closed class where it is still null.
  attendanceCheckedAt DateTime?
  createdAt   DateTime    @default(now())

  attendances Attendance[]
  announcements Announcement[]
  resources     Resource[]
  warningsAsTrigger  AttendanceWarning[] @relation("AttendanceWarningClass")
  warningsAsPrevious AttendanceWarning[] @relation("AttendanceWarningPreviousClass")
  reminders          ClassReminder[]
  exercises ExerciseClass[]

  @@index([startsAt])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  body           String
  classId        String?
  class          Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  authorId       String
  author         User    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  emailRequested Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries AnnouncementDelivery[]
  resources  Resource[]

  @@index([createdAt])
  @@index([classId])
}

model Resource {
  id           String               @id @default(cuid())
  title        String
  description  String?
  kind         ResourceKind
  uploadStatus ResourceUploadStatus @default(READY)
  originalName String?
  contentType  String?
  sizeBytes    Int?
  objectKey    String?              @unique
  youtubeUrl   String?
  uploadId     String?
  classId      String?
  class        Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  announcementId String?
  announcement   Announcement?      @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User                 @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([uploadStatus, createdAt])
  @@index([classId])
  @@index([announcementId])
}

// Each record snapshots one verified student recipient when an announcement is
// published. The email address is intentionally retained even if the account is
// later changed, so retries target the original audience deterministically.
model AnnouncementDelivery {
  id             String                     @id @default(cuid())
  announcementId String
  announcement   Announcement               @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  recipientEmail String
  payload        Json
  idempotencyKey String                     @unique
  status         AnnouncementDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  lockedUntil    DateTime?
  leaseId        String?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([announcementId, recipientEmail])
  @@index([status, nextAttemptAt])
}

// One row per student emailed when a class is created, asking them to attend and
// check in. Doubles as the delivery outbox (same lease/retry shape as
// AnnouncementDelivery). The address is snapshotted so retries hit the original
// recipient. Only students are ever queued.
model ClassReminder {
  id             String                  @id @default(cuid())
  classId        String
  class          Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail String
  idempotencyKey String                  @unique
  status         ClassReminderStatus     @default(PENDING)
  attempts       Int                     @default(0)
  nextAttemptAt  DateTime                @default(now())
  lockedUntil    DateTime?
  leaseId        String?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([classId, userId])
  @@index([status, nextAttemptAt])
}

model Attendance {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInAt DateTime @default(now())
  // Where the student was when they checked in. Null for check-ins an admin added by hand and for older rows.
  distanceMeters Int?
  accuracyMeters Int?

  @@unique([classId, userId])
  @@index([userId])
}

// One row per warning email sent to a student who missed two classes in a row.
// It doubles as the delivery outbox (same lease/retry shape as
// AnnouncementDelivery), so the "already warned" state can only be SENT once the
// email was really delivered. A warning stays active until the student attends a
// later class or an admin undoes their scheduled deletion (clearedAt); a third
// consecutive miss while a warning is active schedules the account for deletion.
model AttendanceWarning {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The class whose close completed the two-in-a-row streak, and the one before it.
  classId         String
  class           Class                   @relation("AttendanceWarningClass", fields: [classId], references: [id], onDelete: Cascade)
  previousClassId String
  previousClass   Class                   @relation("AttendanceWarningPreviousClass", fields: [previousClassId], references: [id], onDelete: Cascade)
  recipientEmail  String
  idempotencyKey  String                  @unique
  status          AttendanceWarningStatus @default(PENDING)
  attempts        Int                     @default(0)
  nextAttemptAt   DateTime                @default(now())
  lockedUntil     DateTime?
  leaseId         String?
  lastError       String?
  sentAt          DateTime?
  clearedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([userId, classId])
  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
}

// One row per admin points change. The unique idempotencyKey makes retries and
// double submits no-ops that return the original result.
model ScoreAdjustment {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId        String
  delta          Int
  resultingScore Int      @db.SmallInt
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("score_adjustment")
}

enum ExerciseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum ExerciseRunStatus {
  RUNNING
  PASSED
  FAILED
}
enum TestcaseResultStatus {
  PASSED
  FAILED
  UNFINISHED
}
enum TestcaseReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}
model Exercise {
  id String @id @default(cuid())
  title String
  description String
  starterCode String @default("")
  status ExerciseStatus @default(DRAFT)
  creatorId String
  creator User @relation("ExerciseCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  currentRevisionId String? @unique
  currentRevision ExerciseRevision? @relation("CurrentExerciseRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions ExerciseRevision[] @relation("ExerciseRevisions")
  classes ExerciseClass[]
  progress ExerciseProgress[]
  runs ExerciseRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model ExerciseClass {
  exerciseId String
  classId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([exerciseId, classId])
  @@index([classId])
}
model ExerciseRevision {
  id String @id @default(cuid())
  exerciseId String
  exercise Exercise @relation("ExerciseRevisions", fields: [exerciseId], references: [id], onDelete: Cascade)
  currentFor Exercise? @relation("CurrentExerciseRevision")
  number Int
  testcases TestcaseRevision[]
  runs ExerciseRun[]
  passedProgress ExerciseProgress[] @relation("PassedRevision")
  createdAt DateTime @default(now())
  @@unique([exerciseId, number])
}
model TestcaseRevision {
  id String @id @default(cuid())
  revisionId String
  revision ExerciseRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  position Int
  input String
  expectedOutput String
  results TestcaseResult[]
  reports TestcaseReport[]
  @@unique([revisionId, position])
}
model ExerciseProgress {
  id String @id @default(cuid())
  exerciseId String
  userId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestRunId String? @unique
  latestRun ExerciseRun? @relation("LatestRun", fields: [latestRunId], references: [id], onDelete: SetNull)
  passedRevisionId String?
  passedRevision ExerciseRevision? @relation("PassedRevision", fields: [passedRevisionId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
  @@unique([exerciseId, userId])
  @@index([userId])
}
model ExerciseRun {
  id String @id @default(cuid())
  exerciseId String
  userId String
  revisionId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision ExerciseRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  latestFor ExerciseProgress? @relation("LatestRun")
  code String
  status ExerciseRunStatus @default(RUNNING)
  failureReason String?
  results TestcaseResult[]
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([userId, createdAt])
  @@index([exerciseId, userId, createdAt])
}
model TestcaseResult {
  id String @id @default(cuid())
  runId String
  testcaseId String
  run ExerciseRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  testcase TestcaseRevision @relation(fields: [testcaseId], references: [id], onDelete: Restrict)
  status TestcaseResultStatus
  actualOutput String?
  error String?
  @@unique([runId, testcaseId])
}
model TestcaseReport {
  id String @id @default(cuid())
  testcaseId String
  userId String
  testcase TestcaseRevision @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason String
  status TestcaseReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
